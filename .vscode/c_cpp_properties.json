{
    "version": 4,
    "configurations": [
        {
            "name": "ClearCore",

            // Authoritative source of flags, regenerated by the
            // "arduino-cli: compilation database" task. Used for any file
            // that appears in it (i.e. the generated build/sketch/*.ino.cpp).
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",

            // Fallback for files NOT in the database -- which includes the
            // .ino itself, since arduino-cli only records the .ino.cpp it
            // generates. Keep in sync with the database if the core updates.
            "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/arm-none-eabi-gcc/7-2017q4/bin/arm-none-eabi-g++.exe",
            "compilerArgs": [
                "-mthumb",
                "-mcpu=cortex-m4",
                "-mfloat-abi=hard",
                "-mfpu=fpv4-sp-d16"
            ],
            "intelliSenseMode": "gcc-arm",
            "cStandard": "c11",
            "cppStandard": "gnu++11",

            // arduino-cli implicitly prepends Arduino.h to every sketch;
            // IntelliSense has no way to know that, so state it explicitly.
            "forcedInclude": [
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/cores/arduino/Arduino.h"
            ],

            "includePath": [
                "${workspaceFolder}/sketch/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/cores/arduino",
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/cores/arduino/api",
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/variants/clearcore",
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/variants/clearcore/Third Party/SAME53/CMSIS/Device/Include",
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/Teknic/libClearCore/inc",
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/Teknic/LwIP/LwIP/src/include",
                "${env:LOCALAPPDATA}/Arduino15/packages/ClearCore/hardware/sam/1.7.1/Teknic/LwIP/LwIP/port/include",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/CMSIS/4.5.0/CMSIS/Include"
            ],

            "defines": [
                "F_CPU=120000000L",
                "__FPU_PRESENT=1",
                "ARDUINO=10607",
                "ARDUINO_ARM_ClearCore",
                "ARDUINO_ARCH_SAM",
                "__ARM_FEATURE_DSP=1",
                "CPPUTEST_USE_MEM_LEAK_DETECTION=0",
                "USB_VID=0x2890",
                "USB_PID=0x0022",
                "USB_MANUFACTURER=\"Teknic, Inc.\"",
                "USB_PRODUCT=\"Teknic ClearCore\"",
                "DEBUG",
                "USBCON",
                "USB_CONFIG_POWER=0",
                "__CLEARCORE__",
                "__SAME53N19A__",
                "ARM_MATH_CM4"
            ]
        }
    ]
}
